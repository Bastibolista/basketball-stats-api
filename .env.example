# Copy to .env (gitignored) and fill in. The API refuses to start without these.
DB_PASSWORD=
APP_AUTH_USERNAME=
# bcrypt hash, single-quoted so Compose does not expand the $ signs:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
APP_AUTH_PASSWORD_HASH=''
# At least 32 characters:  openssl rand -base64 48
APP_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
